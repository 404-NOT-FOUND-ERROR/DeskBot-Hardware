* text=auto eol=lf
*.md text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.cc text eol=lf
*.c text eol=lf
*.h text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
*.cjs text eol=lf
*.txt text eol=lf
*.sha256 text eol=lf
*.bin binary
*.a binary
*.eaf binary
*.ogg binary
*.wav binary
*.png binary
*.jpg binary

# Preserve the input snapshot's exact bytes for SOURCE_MANIFEST.sha256.
firmware/body/** -text

# Archived evidence is hashed as bytes and keeps its recorded line endings.
artifacts/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Historical review fixtures preserve their original SHA-256 source anchors.
tests/fixtures/expression-e1-28/*.cc -text
tests/fixtures/expression-e1-28/*.cc whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof,-space-before-tab

# E3b source records identify these exact bytes, including line endings.
protocol/deskbot-body-observation-v2.schema.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
scripts/deskbot-studio-e3b.css -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
protocol/deskbot-studio-display-v1.schema.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
scripts/validate-deskbot-studio-e3c3.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
scripts/validate-deskbot-studio-e3c4.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Imported snapshots and patch context retain upstream whitespace.
firmware/body/** whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof,-space-before-tab
firmware/base/source/** whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof,-space-before-tab
firmware/base/patches/** whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof,-space-before-tab
