{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deskbot.local/protocol/deskbot-studio-session-v1.schema.json",
  "title": "DeskBot Studio USB session v1",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/reply" }
  ],
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}(?![\\s\\S])" },
    "sessionId": { "type": "string", "pattern": "^session-[a-f0-9]{32}-[1-9][0-9]{0,9}(?![\\s\\S])" },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "operation", "request_id", "target_id", "boot_id", "client_nonce", "session_id"],
      "properties": {
        "schema": { "const": "deskbot.studio_session/v1" },
        "operation": { "$ref": "#/$defs/identifier" },
        "request_id": { "$ref": "#/$defs/identifier" },
        "target_id": { "$ref": "#/$defs/identifier" },
        "boot_id": { "$ref": "#/$defs/identifier" },
        "client_nonce": { "$ref": "#/$defs/identifier" },
        "session_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/identifier" }] }
      }
    },
    "reply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "message_type", "request_id", "target_id", "boot_id", "sequence", "session_id", "state", "reason", "at_ms", "lease_ms", "controls_available"],
      "properties": {
        "schema": { "const": "deskbot.studio_session/v1" },
        "message_type": { "const": "session" },
        "request_id": { "$ref": "#/$defs/identifier" },
        "target_id": { "type": "string", "pattern": "^device-[a-f0-9]{32}(?![\\s\\S])" },
        "boot_id": { "type": "string", "pattern": "^boot-[a-f0-9]{32}(?![\\s\\S])" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "session_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sessionId" }] },
        "state": { "enum": ["ready", "closed", "rejected"] },
        "reason": { "$ref": "#/$defs/identifier" },
        "at_ms": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "lease_ms": { "enum": [0, 30000] },
        "controls_available": { "const": false }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "rejected" } }, "required": ["state"] },
          "then": { "properties": { "session_id": { "type": "null" }, "lease_ms": { "const": 0 } } },
          "else": { "properties": { "session_id": { "$ref": "#/$defs/sessionId" } } }
        },
        {
          "if": { "properties": { "state": { "const": "ready" } }, "required": ["state"] },
          "then": { "properties": { "lease_ms": { "const": 30000 } } },
          "else": { "properties": { "lease_ms": { "const": 0 } } }
        }
      ]
    }
  }
}
