{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deskbot.local/protocol/mcp-host-visibility-e1-42.schema.json",
  "title": "DeskBot E1.42 MCP host visibility capture",
  "description": "Offline paired tools/list and tools/call evidence from one MCP host. It is not a device transport contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "host_received_at_utc", "list_pages", "tool_calls"],
  "properties": {
    "schema": {"const": "deskbot.mcp.host_visibility.e1_42/v1"},
    "host_received_at_utc": {"type": "string", "format": "date-time"},
    "list_pages": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/exchange"}},
    "tool_calls": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/exchange"}}
  },
  "$defs": {
    "exchange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_message", "response_message"],
      "properties": {
        "request_message": {"$ref": "#/$defs/envelope"},
        "response_message": {"$ref": "#/$defs/envelope"}
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": {"const": "mcp"},
        "session_id": {"type": "string", "maxLength": 256},
        "payload": {"type": "object"}
      }
    }
  }
}
