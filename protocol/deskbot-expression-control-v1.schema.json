{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deskbot.local/protocol/expression-control/v1",
  "title": "DeskBot 表达控制消息 v1",
  "oneOf": [{ "$ref": "#/$defs/request" }, { "$ref": "#/$defs/receipt" }, { "$ref": "#/$defs/base_fact" }],
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$" },
    "counter": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "message_type", "request_id", "target_id", "boot_id", "session_id", "sequence", "catalog_id", "role_id", "issued_at", "expires_after_ms", "command"],
      "properties": {
        "schema": { "const": "deskbot.expression_control/v1" }, "message_type": { "const": "request" },
        "request_id": { "$ref": "#/$defs/identifier" }, "target_id": { "$ref": "#/$defs/identifier" },
        "boot_id": { "$ref": "#/$defs/identifier" }, "session_id": { "$ref": "#/$defs/identifier" },
        "sequence": { "$ref": "#/$defs/counter" }, "catalog_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "role_id": { "$ref": "#/$defs/identifier" }, "issued_at": { "type": "string", "format": "date-time" },
        "expires_after_ms": { "type": "integer", "minimum": 100, "maximum": 10000 },
        "command": { "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["kind", "semantic_id"], "properties": { "kind": { "const": "play_expression" }, "semantic_id": { "$ref": "#/$defs/identifier" } } },
          { "type": "object", "additionalProperties": false, "required": ["kind", "action_id"], "properties": { "kind": { "const": "play_action" }, "action_id": { "$ref": "#/$defs/identifier" } } }
        ] }
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "message_type", "target_id", "boot_id", "session_id", "sequence", "request_id", "request_sequence", "status", "reason", "source", "correlated", "original_status", "at_ms"],
      "properties": {
        "schema": { "const": "deskbot.expression_control/v1" }, "message_type": { "const": "receipt" },
        "target_id": { "$ref": "#/$defs/identifier" }, "boot_id": { "$ref": "#/$defs/identifier" },
        "session_id": { "$ref": "#/$defs/identifier" }, "sequence": { "$ref": "#/$defs/counter" },
        "request_id": { "$ref": "#/$defs/identifier" }, "request_sequence": { "$ref": "#/$defs/counter" },
        "status": { "enum": ["accepted", "dispatched", "busy", "rejected", "interrupted", "expired", "duplicate"] },
        "reason": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,95}$" },
        "source": { "enum": ["simulator", "device"] }, "correlated": { "const": true },
        "original_status": { "enum": ["accepted", "dispatched", "busy", "rejected", "interrupted", "expired", null] },
        "at_ms": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "duplicate" } } },
          "then": { "properties": { "original_status": { "enum": ["accepted", "dispatched", "busy", "rejected", "interrupted", "expired"] } } },
          "else": { "properties": { "original_status": { "type": "null" } } } }
      ]
    },
    "base_fact": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "message_type", "target_id", "boot_id", "session_id", "sequence", "fact", "request_id", "correlated", "source", "at_ms"],
      "properties": {
        "schema": { "const": "deskbot.expression_control/v1" }, "message_type": { "const": "base_fact" },
        "target_id": { "$ref": "#/$defs/identifier" }, "boot_id": { "$ref": "#/$defs/identifier" },
        "session_id": { "$ref": "#/$defs/identifier" }, "sequence": { "$ref": "#/$defs/counter" },
        "fact": { "const": "base.action.completed" }, "request_id": { "type": "null" },
        "correlated": { "const": false }, "source": { "enum": ["simulator", "device"] },
        "at_ms": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    }
  }
}
