{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deskbot:storage-upper-pattern:e1-43a:v1",
  "title": "E1.43a offline address-test pattern; not a deployment plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "edition", "format_version", "purpose", "start", "bytes", "end_exclusive", "sector_bytes", "header_bytes", "sha256", "algorithm", "blocks", "deployment_eligible"],
  "properties": {
    "schema": {"const": "deskbot.upper_pattern.manifest.v1"},
    "edition": {"const": "E1.43a"},
    "format_version": {"type": "integer", "const": 1},
    "purpose": {"const": "address_test_pattern_not_eaf"},
    "start": {"type": "integer", "const": 16777216},
    "bytes": {"type": "integer", "const": 65536},
    "end_exclusive": {"type": "integer", "const": 16842752},
    "sector_bytes": {"type": "integer", "const": 4096},
    "header_bytes": {"type": "integer", "const": 64},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "algorithm": {"const": "sha256_counter_per_sector_v1"},
    "deployment_eligible": {"type": "boolean", "const": false},
    "blocks": {
      "type": "array", "minItems": 16, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["index", "relative_offset", "absolute_offset", "bytes", "sha256", "header_hex"],
        "properties": {
          "index": {"type": "integer", "minimum": 0, "maximum": 15},
          "relative_offset": {"type": "integer", "minimum": 0, "maximum": 61440, "multipleOf": 4096},
          "absolute_offset": {"type": "integer", "minimum": 16777216, "maximum": 16838656, "multipleOf": 4096},
          "bytes": {"type": "integer", "const": 4096},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "header_hex": {"type": "string", "pattern": "^[0-9a-f]{128}$"}
        }
      }
    }
  }
}
