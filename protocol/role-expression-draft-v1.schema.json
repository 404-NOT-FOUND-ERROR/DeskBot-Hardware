{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deskbot.local/protocol/role-expression-draft-v1.schema.json",
  "title": "Offline role expression draft v1 (E1.31)",
  "description": "Companion to role_profile.v1. expression_map remains intent -> semantic; semantic_resources is a separate offline semantic -> EAF selection. Context validation is also required.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "edition", "scope", "firmware_deployable", "draft_revision", "baseline", "selected_role_id", "roles"],
  "properties": {
    "schema": {"const": "deskbot.role_expression_draft/v1"},
    "edition": {"const": "E1.31"},
    "scope": {"const": "offline_draft_only"},
    "firmware_deployable": {"const": false},
    "draft_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "selected_role_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"},
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["release_id", "package_sha256", "index_sha256", "mapping_sha256", "catalog_sha256"],
      "properties": {
        "release_id": {"const": "E1.18"},
        "package_sha256": {"$ref": "#/$defs/hash"},
        "index_sha256": {"$ref": "#/$defs/hash"},
        "mapping_sha256": {"$ref": "#/$defs/hash"},
        "catalog_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "roles": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role_profile", "semantic_resources"],
        "properties": {
          "role_profile": {
            "allOf": [
              {"$ref": "deskbot-role-profile-v1.schema.json"},
              {"required": ["binding_version"], "properties": {
                "binding_state": {"const": "draft"},
                "binding_version": {"const": "deskbot.expression_bindings/v1"},
                "asset_version": {"const": "deskbot.expression_assets/e1-18"}
              }}
            ]
          },
          "semantic_resources": {
            "type": "object", "minProperties": 29, "maxProperties": 29,
            "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"},
            "additionalProperties": {"anyOf": [
              {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}\\.eaf$"},
              {"type": "null"}
            ]}
          }
        }
      }
    }
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
