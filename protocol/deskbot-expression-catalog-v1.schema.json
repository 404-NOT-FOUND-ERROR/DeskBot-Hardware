{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deskbot.local/protocol/expression-catalog/v1",
  "title": "DeskBot 表达目录 v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "catalog_id", "library_catalog_id", "revision", "role_id", "source", "live", "device", "expressions", "actions", "limits"],
  "properties": {
    "schema": { "const": "deskbot.expression_catalog/v1" },
    "catalog_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "library_catalog_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "revision": { "const": "E1.18" },
    "role_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$" },
    "source": { "const": "saved_release_record" },
    "live": { "const": false },
    "device": { "type": "object", "additionalProperties": false, "required": ["source", "live", "app", "bootloader", "assets", "layout", "flash_bytes", "psram_bytes"], "properties": { "source": { "const": "saved_release_record" }, "live": { "const": false }, "app": { "type": "string" }, "bootloader": { "type": "string" }, "assets": { "const": "E1.18" }, "layout": { "const": "upper-assets-8m" }, "flash_bytes": { "const": 33554432 }, "psram_bytes": { "const": 16777216 } } },
    "expressions": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "object", "additionalProperties": false, "required": ["semantic_id", "label", "resource_id", "layout_id", "fps", "loop", "requestable", "implicit_action_id"], "properties": { "semantic_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$" }, "label": { "type": "string", "minLength": 1 }, "resource_id": { "type": "string", "pattern": "^[A-Za-z0-9_]+\\.eaf$" }, "layout_id": { "enum": ["eye_anim", "listen_anim"] }, "fps": { "type": "integer", "minimum": 1, "maximum": 60 }, "loop": { "type": "boolean" }, "requestable": { "type": "boolean" }, "implicit_action_id": { "type": ["string", "null"] } } } },
    "actions": { "type": "array", "maxItems": 32, "items": { "type": "object", "additionalProperties": false, "required": ["action_id", "label", "wire_command", "wire_value", "completion"], "properties": { "action_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$" }, "label": { "type": "string", "minLength": 1 }, "wire_command": { "const": 2 }, "wire_value": { "type": "integer", "minimum": 0, "maximum": 4 }, "completion": { "const": "fact_only" } } } },
    "limits": { "const": { "max_inflight": 1, "max_history": 24, "max_dedup": 64, "default_timeout_ms": 3000 } }
  }
}
