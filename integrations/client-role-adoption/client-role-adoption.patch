+function memoryPersistence() {
+  const tables = new Map();
+  return {
+    get(namespace, id) { return tables.get(namespace)?.get(id) ?? null; },
+    list(namespace) { return [...(tables.get(namespace)?.values() ?? [])]; },
+    put(namespace, id, value) {
+      let table = tables.get(namespace);
+      if (!table) tables.set(namespace, table = new Map());
+      table.set(id, structuredClone(value));
+      return value;
+    },
+  };
+}
