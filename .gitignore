artifacts/*-live-deployment-*/
*.key
*.pem
*.p12
.vscode/
.idea/
Thumbs.db
desktop.ini

# Required runtime assets and the pinned local touch component are inputs,
# including their .bin resources and precompiled .a libraries. Do not ignore
