+static void stepper_profile_for_steps(int steps, int *accel_steps, int *decel_steps)
+{
+    if (steps <= 1) {
+        *accel_steps = 0;
+        *decel_steps = 0;
+        return;
+    }
+
+    int accel = STEPPER_ACCEL_STEPS;
+    int decel = STEPPER_DECEL_STEPS;
+    if (accel + decel > steps) {
