# Applied to an isolated copy of the accepted E1.42 configuration.
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"
CONFIG_ESPTOOLPY_OCT_FLASH=y
CONFIG_ESPTOOLPY_FLASHMODE_OPI=y
# CONFIG_ESPTOOLPY_FLASH_MODE_AUTO_DETECT is not set
CONFIG_ESPTOOLPY_FLASH_SAMPLE_MODE_STR=y
# CONFIG_ESPTOOLPY_FLASH_SAMPLE_MODE_DTR is not set
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/deskbot-upper-assets-8m.csv"
# Resource package is built and reviewed separately from the App image.
# CONFIG_FLASH_CUSTOM_ASSETS is not set
# CONFIG_FLASH_DEFAULT_ASSETS is not set
# CONFIG_FLASH_EXPRESSION_ASSETS is not set
CONFIG_FLASH_NONE_ASSETS=y
